{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@components/*": ["./components/*"],
			"@utils/*": ["./utils/*"],
			"@interfaces/*": ["./interfaces/*"],
			"@icons/*": ["./public/icons/*"],
			"@hooks/*": ["./src/hooks/*"],
			"@pages/*": ["./src/pages/*"],
			"@store/*": ["./src/store/*"]
		}
	},
	"include": [
		"src",
		"components",
		"utils",
		"interfaces",
		"icons",
		"hooks",
		"pages",
		"store"
	]
}
